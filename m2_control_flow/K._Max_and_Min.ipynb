    "inp = input()\n",
    "inp = inp.split()\n",
    "\n",
    "x = int(inp[0])\n",
    "y = int(inp[1])\n",
    "z = int(inp[2])\n",
    "\n",
    "mn = x\n",
    "mx = x\n",
    "\n",
    "if(y < mn) :\n",
    "    mn = y\n",
    "if(z < mn) :\n",
    "    mn = z\n",
    "\n",
    "if(y > mx) :\n",
    "    mx = y\n",
    "if(z > mx) :\n",
    "    mx = z\n",
    "\n",
    "\n",
    "print(mn, mx)"
   ]
