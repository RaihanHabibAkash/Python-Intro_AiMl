   "source": [
    "inp = int(input())\n",
    "arr = input()\n",
    "arr = arr.split()\n",
    "\n",
    "min = int(arr[0]) ; index = 0\n",
    "\n",
    "for i in range(1, inp) :\n",
    "    if(min > int(arr[i])) :\n",
    "        min = int(arr[i])\n",
    "        index = i\n",
    "\n",
    "print(min, index+1)"
   ]
  }
