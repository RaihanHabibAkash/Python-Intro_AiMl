   "source": [
    "n = int(input())\n",
    "sum_odd = 0\n",
    "\n",
    "for i in range(1, n+1) :\n",
    "    if i % 2 == 0 :\n",
    "        continue\n",
    "    sum_odd += i\n",
    "print(sum_odd)"
