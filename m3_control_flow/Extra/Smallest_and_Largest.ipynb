   "source": [
    "n = int(input())\n",
    "lst = list(map(int, input().split()))\n",
    "\n",
    "mn = lst[0] ; mx = lst[0]\n",
    "\n",
    "for x in lst :\n",
    "    if x < mn :\n",
    "        mn = x\n",
    "    if x > mx :\n",
    "        mx = x\n",
    "        \n",
    "print(mn, mx)"
   ]
