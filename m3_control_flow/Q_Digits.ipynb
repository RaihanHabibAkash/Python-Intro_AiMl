   "source": [
    "cs = int(input())\n",
    "\n",
    "for i in range(cs) :\n",
    "    n = int(input())\n",
    "\n",
    "    if(n == 0) :\n",
    "        print(n, end = \" \")\n",
    "\n",
    "    while n > 0 :\n",
    "        print(n % 10, end=\" \")\n",
    "        n = n // 10\n",
    "\n",
    "    print()"
   ]
