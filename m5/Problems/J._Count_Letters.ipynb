   ],
   "source": [
    "words = input()\n",
    "freq = [0 for i in range(26)]\n",
    "\n",
    "for word in words :\n",
    "    freq[ord(word) - ord('a')] += 1\n",
    "\n",
    "for x in range(26) :\n",
    "    if freq[x] > 0 :\n",
    "        print(f\"{chr(x + ord('a'))} : {freq[x]}\")"
   ]
