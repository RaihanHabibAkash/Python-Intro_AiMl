    "n = int(input())\n",
    "target = float(input())\n",
    "\n",
    "sum = 0.0\n",
    "for i in range(n) :\n",
    "    sum += float(input())\n",
    "\n",
    "avg = sum / n\n",
    "\n",
    "if(avg <= target) :\n",
    "    print(\"PASS\")\n",
    "else :\n",
    "    print(\"RETRY\")"
