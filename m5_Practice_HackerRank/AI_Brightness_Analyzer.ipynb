   "source": [
    "inp = input().split()\n",
    "\n",
    "sum = 0;\n",
    "\n",
    "for i in range(len(inp)) :\n",
    "    sum += int(inp[i])\n",
    "\n",
    "avg = sum / len(inp)\n",
    "\n",
    "if avg < 85 :\n",
    "    print(\"Dark Image\")\n",
    "elif avg <= 170 :\n",
    "    print(\"Normal Image\")\n",
    "else :\n",
    "    print(\"Bright Image\")"
   ]
