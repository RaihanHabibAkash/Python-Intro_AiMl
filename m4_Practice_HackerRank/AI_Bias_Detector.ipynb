   "source": [
    "inp = input().split()\n",
    "\n",
    "a = 0;\n",
    "\n",
    "for i in range(len(inp)) :\n",
    "    if inp[i] == 'A' :\n",
    "        a += 1\n",
    "\n",
    "per = (a / len(inp)) * 100\n",
    "\n",
    "if per > 70 or per < 30 :\n",
    "    print(\"Biased Model\")\n",
    "else :\n",
    "    print(\"Fair Model\")"
   ]
