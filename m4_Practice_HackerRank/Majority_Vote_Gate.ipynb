   "source": [
    "n = int(input())\n",
    "yes = 0 ; no = 0\n",
    "\n",
    "while n > 0 :\n",
    "    if input() == \"YES\" :\n",
    "        yes += 1\n",
    "    else :\n",
    "        no += 1\n",
    "    n -= 1\n",
    "\n",
    "if yes >= no :\n",
    "    print(\"ACCEPT\")\n",
    "else :\n",
    "    print(\"REJECT\")"
   ]
